# No API keys are needed - every model runs locally. All settings are optional.
ASTRA_DEFAULT_MODEL=siglip-probe       # siglip-probe | siglip-zeroshot | effnet-probe
ASTRA_MAX_UPLOAD_MB=15
ASTRA_MAX_PIXELS=50000000
ASTRA_MAX_BATCH=25
ASTRA_STORAGE_DIR=./storage            # history database location
# ASTRA_SIGLIP_MODEL=google/siglip2-base-patch16-224
# ASTRA_EFFNET_MODEL=efficientnet_b0.ra_in1k
# ASTRA_OWL_MODEL=google/owlv2-base-patch16-ensemble
